APP_ENV=development
CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]

SIMULATION_MIN_TIME=2025-11-01T00:00:00-07:00
SIMULATION_START_TIME=2025-12-06T10:00:00-08:00
SIMULATION_MAX_TIME=2026-08-31T23:00:00-07:00
SIMULATION_SPEED=1
AUTO_PAUSE_ON_PROPOSAL=true
APPROVAL_TIMEOUT_MINUTES=30

# Fixture mode is explicit and never falls back from a failed external source.
DATA_MODE=fixture
DATA_SOURCE_VERSION=development-fixture-v1
# Required when DATA_MODE=databricks. Keep real tokens in local/deployment secrets.
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
# DATABRICKS_TOKEN=replace-with-a-scoped-token
# DATA_CATALOG=your_catalog
# DATA_SCHEMA=your_schema
DISPATCH_EVENTS_TABLE=dispatch_events
EVENT_WINDOW_START=2026-07-10T09:00:00-07:00
EVENT_WINDOW_END=2026-07-10T15:00:00-07:00
GTFS_FEED_VERSION=fall-2026
HUB_ALIASES={"UBC":"ubc"}
ROUTE_ALIASES={"99":"fixture-99"}
DESTINATION_ALIASES={"Downtown":["ALMA"],"Broadway":["ALMA"]}
DIRECTION_ALIASES={"0":0,"1":1}

FLEET_SIZE=3
DEFAULT_BUS_CAPACITY=50
DEFAULT_FLEET_LOCATION_ID=ubc
FLEET_CONFIG_PATH=config/fleet.json
MAX_BUSES_PER_EVENT=3
ROUTING_PROVIDER=straight_line
ROUTING_SPEED_KPH=30
PROACTIVE_LATENESS_TOLERANCE_SECONDS=0
RETURN_POLICY=home
GTFS_SOURCE=data/gtfs
