# REST base for the backend contract (message.txt)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Simulation WebSocket. Must be wss:// when the app is served over https.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/simulation
# true = MSW + in-browser MockSim + fake WebSocket. Set to false for the real backend; no other change needed.
NEXT_PUBLIC_USE_MOCKS=true
# Online basemaps (CARTO GL styles). If they fail to load within 3 s, the app falls back to public/tiles/metro-vancouver.pmtiles.
NEXT_PUBLIC_BASEMAP_LIGHT_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
NEXT_PUBLIC_BASEMAP_DARK_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
