   "layout": [
    {
     "widget": {
      "name": "val-header",
      "multilineTextboxSpec": {
       "lines": [
        "## Can synthetic pings stand in for real riders?\n",
        "\n",
        "Waterfront's weekday ping profile tracks TransLink's **real 2025 SkyTrain boardings + alightings at Waterfront Station** with a correlation of **r \u2248 0.92**. Shifting the pings by 3 hours drops it to 0.38 \u2014 which is also how we confirmed the source timestamps are local time, despite their `Z` suffix."
       ]
      }
     },
     "position": {
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 3
     }
    },
    {
     "widget": {
      "name": "val-line",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "ds_validation",
         "fields": [
          {
           "name": "hour_label",
           "expression": "`hour_label`"
          },
          {
           "name": "sum(pings_share)",
           "expression": "SUM(`pings_share`)"
          },
          {
           "name": "sum(skytrain_share)",
           "expression": "SUM(`skytrain_share`)"
          }
         ],
         "disaggregated": false
        }
       }
      ],
      "spec": {
       "version": 3,
       "widgetType": "line",
       "encodings": {
        "x": {
         "fieldName": "hour_label",
         "scale": {
          "type": "categorical"
         },
