           "fieldName": "sum(pings_share)",
           "displayName": "Visit pings (hackathon)"
          },
          {
           "fieldName": "sum(skytrain_share)",
           "displayName": "SkyTrain riders (TransLink 2025)"
          }
         ]
        }
       },
       "frame": {
        "showTitle": true,
        "title": "Waterfront weekday: share of daily activity by hour"
       }
